<!-- Optional AWS CloudTrail collection example for the Wazuh manager.
     Use only with an instructor-approved lab bucket and credentials profile.
     Confirm this configuration against the installed Wazuh version. -->
<wodle name="aws-s3">
  <disabled>no</disabled>
  <interval>10m</interval>
  <run_on_start>yes</run_on_start>
  <skip_on_error>yes</skip_on_error>
  <bucket type="cloudtrail">
    <name>REPLACE_WITH_APPROVED_CLOUDTRAIL_BUCKET</name>
    <aws_profile>REPLACE_WITH_CONFIGURED_PROFILE</aws_profile>
  </bucket>
</wodle>
